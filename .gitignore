# Android native build intermediates (CMake/Ninja) written by the player build
/.utmp/
# Generated by the performance test framework on every PlayMode run
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json*
# Never ignore Asset meta data
!/[Aa]ssets/**/*.meta

# Empty folders that regenerate on their own (performance test runs, MCP
# screenshots). Remove these rules if a real Resources folder is ever needed.
# Below the meta negation on purpose: a later rule wins.
/Assets/Resources/
/Assets/Resources.meta
/Assets/Screenshots/
/Assets/Screenshots.meta

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity Services credentials — never commit
/[Aa]ssets/[Ss]treamingAssets/UnityServicesProjectConfiguration.json

# IDEs
.vs/
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Claude Code — local, per-machine settings
.claude/settings.local.json
